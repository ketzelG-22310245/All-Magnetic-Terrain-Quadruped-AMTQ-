    <parent link="arm_1_3__cut_extrude2_3"/>
    <child link="arm_2_3__cut_extrude4_3"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0" upper="0.785398"/>
  </joint>
  <!-- Joint from base_link to arm_1_3__cut_extrude2_3 -->
  <joint name="front_right_coxa_joint" type="revolute">
    <origin xyz="-0.0802 -0.0649 0.0363" rpy="-3.14159 -0 -2.10168"/>
    <parent link="base_link"/>
    <child link="arm_1_3__cut_extrude2_3"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.53088" upper="1.99985"/>
  </joint>

  <!-- Plugin gz_ros2_control para Gazebo Harmonic -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find quadruped_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Interfaces de ros2_control para las 12 articulaciones -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Front Left -->
    <joint name="front_left_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_left_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_left_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>

    <!-- Front Right -->
    <joint name="front_right_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_right_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_right_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>

    <!-- Back Left -->
    <joint name="back_left_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="back_left_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="back_left_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>

    <!-- Back Right -->
    <joint name="back_right_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="back_right_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="back_right_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
